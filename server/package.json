{
  "name": "closetcloud-server",
  "description": "ClosetCloud REST API (Express + PostgreSQL + Prisma)",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node src/index.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "pretest": "node --env-file=.env.test node_modules/prisma/build/index.js migrate deploy",
    "test": "node --env-file=.env.test --test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "dotenv": "18.0.8",
    "prisma": "7.10.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
